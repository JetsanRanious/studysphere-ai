# StudySphere AI Root Environment Configuration

# Backend Configuration
SECRET_KEY=studysphere-super-secret-key-change-in-production-2026
DATABASE_URL=sqlite:///./studysphere.db
# For PostgreSQL in production or Docker:
# DATABASE_URL=postgresql://studysphere_user:studysphere_pass@localhost:5432/studysphere_db

# Google OAuth Credentials (Optional for local dev, Demo login works out-of-the-box)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api
